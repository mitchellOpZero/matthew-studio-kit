{
  "_about": "Premium motion for a creative ask. Kinetic captions in Outfit, gold and cream type, and custom graphics (kinetic labels, lower thirds, animated stats, callouts, swipes). A plain Short still uses matthew.",
  "font": "Outfit",
  "font_file": "Outfit-Bold.ttf",
  "font_size_frac": 0.07,
  "color": "#F6F1E8",
  "highlight_color": "#E4B15A",
  "stroke_color": "#141210",
  "stroke": 0,
  "shadow": 0,
  "center_y_frac": 0.5,
  "uppercase": true,
  "one_line": true,
  "max_words": 2,
  "max_chars": 14,
  "min_chunk_s": 0.28,
  "gap_break_s": 0.35,
  "kw_sync_pop": true,
  "kw_pop_pct": 8,
  "keyword_scale": 1.08,
  "pop_scale": 1.0,
  "pop_ms": 280,
  "caption_template": "kinetic",
  "punch": {
    "every_s": 2.2,
    "zoom_wide": 1.0,
    "zoom_tight": 1.22,
    "even": true,
    "max_s": 2.2,
    "anchor_y": 0.32,
    "min_piece_s": 0.55
  },
  "xfade_ms": 12,
  "end_fade_s": 0.2,
  "loudness": {"I": -14, "TP": -1.5, "LRA": 11},
  "logos": {
    "enabled": true,
    "youtube": "assets/logos/youtube_icon_red.png",
    "instagram": "assets/logos/Instagram_Glyph_Gradient.png"
  },
  "music": {"enabled": false},
  "sfx_on_graphics": false,
  "graphic": {"size_frac": 0.048, "y_frac": 0.14, "box_color": "#141210", "text_color": "#F6F1E8"}
}
