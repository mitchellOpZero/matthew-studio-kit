{
  "_about": "Matthew's old red style (not the default; only when he asks for it by name). The basics: white captions, his crimson on each keyword as it is spoken, one line, 1.5x size; snap punch-ins; his voice at -14 LUFS, no music. Edit with the style skill; old versions are in versions/.",
  "font": "Montserrat ExtraBold",
  "font_file": "Montserrat-ExtraBold.ttf",
  "font_size_frac": 0.093,
  "color": "#FFFFFF",
  "highlight_color": "#DC143C",
  "stroke_color": "#000000",
  "stroke": 7,
  "shadow": 2,
  "center_y_frac": 0.64,
  "uppercase": false,
  "one_line": true,
  "max_words": 2,
  "max_chars": 13,
  "min_chunk_s": 0.22,
  "gap_break_s": 0.35,
  "kw_sync_pop": true,
  "kw_pop_pct": 0,
  "keyword_scale": 1.0,
  "pop_scale": 1.06,
  "pop_ms": 150,
  "punch": {"every_s": 2.5, "zoom_wide": 1.0, "zoom_tight": 1.17, "even": true, "max_s": 2.4, "anchor_y": 0.3, "min_piece_s": 0.6},
  "xfade_ms": 12,
  "end_fade_s": 0.15,
  "loudness": {"I": -14, "TP": -1.5, "LRA": 11},
  "logos": {"enabled": true, "youtube": "assets/logos/youtube_icon_red.png", "instagram": "assets/logos/Instagram_Glyph_Gradient.png"},
  "music": {"enabled": false},
  "sfx_on_graphics": false
}
